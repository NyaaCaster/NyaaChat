# syntax=docker/dockerfile:1.7
FROM node:20-alpine

WORKDIR /app
ENV NODE_ENV=production

COPY package.json ./
COPY src ./src
# Build-time aggregated outbound allowlist (generated by
# scripts/generate-extension-registry.mjs before `docker compose build`).
# rebuild.ps1 / rebuild.sh always regenerate it first.
COPY network-allowlist.generated.json ./

EXPOSE 3099
CMD ["npm", "start"]
