# NyaaChat environment configuration — TEMPLATE
#
# Copy to `.env` and fill in real values. `.env` is git-ignored; this template
# is tracked. Standard dotenv format: KEY=VALUE, lines starting with # are
# comments.

# === HTTP server (NyaaChat-MCP) ===
# Listen address and port of the MCP streamable-HTTP service that nginx proxies
# at /api/mcp. Override per-environment if the port is taken.
MCP_HOST=http://your-mcp-host
MCP_PORT=

# Shared secret required by clients in the `Authorization: Bearer <key>` header.
# Leave empty/unset to disable auth (development only — server logs a warning).
# Generate via:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
MCP_API_KEY=

# === Time zone ===
TZ=Asia/Shanghai

# === ComfyUI 固定服务器（NyaaComfyUI）===
# 固定生图服务器的真实地址。出于安全，前端只请求同源 /api/comfyui/fixed/*，
# 由 nginx 在容器启动时用 envsubst 注入此地址（NGINX_ENVSUBST_FILTER 已放行
# COMFYUI_ 前缀），因此该地址不会出现在前端构建产物中。
# 兼容末尾有无 "/"；不要带路径。
COMFYUI_FIXED_URL=http://your-comfyui-host:0000
# 固定服务器在 UI「生图模型供应商」中的显示名称（非密钥，经 Vite define 注入前端）。
COMFYUI_FIXED_NAME=NyaaComfyUI
# 固定服务器详情页名称下方的小字描述（非密钥，经 Vite define 注入前端）。
COMFYUI_FIXED_DESC=NyaaChat本地部署Comfyui服务器
# 固定服务器鉴权 token（密钥）。若 ComfyUI 服务开启了鉴权则填写；为空表示无鉴权。
# 出于安全，token 仅经 nginx envsubst 以 `Authorization: Bearer <token>` 头服务端注入，
# 绝不进入前端构建产物或浏览器可见的 URL。留空时发送空 Bearer 头（无鉴权服务通常忽略）。
# 原样发送：token 含 `$`（如 ComfyUI 自动生成的 "$2b$12$..." 形态）也安全——nginx 用
# geo 字面量持有该值，不会把 `$` 误当变量解析。直接粘贴原始 token，无需转义/编码。
COMFYUI_FIXED_TOKEN=
