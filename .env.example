# NyaaChat environment configuration — TEMPLATE
#
# Copy to `.env` and fill in real values. `.env` is git-ignored; this template
# is tracked. Standard dotenv format: KEY=VALUE, lines starting with # are
# comments.

# === HTTP server (NyaaChat-MCP) ===
# Listen address and port of the MCP streamable-HTTP service that nginx proxies
# at /api/mcp. Override per-environment if the port is taken.
MCP_HOST=http://your-mcp-host
MCP_PORT=

# Shared secret required by clients in the `Authorization: Bearer <key>` header.
# Leave empty/unset to disable auth (development only — server logs a warning).
# Generate via:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
MCP_API_KEY=

# === Time zone ===
TZ=Asia/Shanghai

# === ComfyUI 固定服务器（NyaaComfyUI）===
# 固定生图服务器的真实地址。出于安全，前端只请求同源 /api/comfyui/fixed/*，
# 由 nginx 在容器启动时用 envsubst 注入此地址（NGINX_ENVSUBST_FILTER 已放行
# COMFYUI_ 前缀），因此该地址不会出现在前端构建产物中。
# 兼容末尾有无 "/"；不要带路径。
COMFYUI_FIXED_URL=http://your-comfyui-host:0000
# 固定服务器在 UI「生图模型供应商」中的显示名称（非密钥，经 Vite define 注入前端）。
COMFYUI_FIXED_NAME=NyaaComfyUI
# 固定服务器详情页名称下方的小字描述（非密钥，经 Vite define 注入前端）。
COMFYUI_FIXED_DESC=NyaaChat本地部署Comfyui服务器
# 固定服务器鉴权 token（密钥）。若 ComfyUI 服务开启了鉴权则填写；为空表示无鉴权。
# 出于安全，token 仅经 nginx envsubst 以 `Authorization: Bearer <token>` 头服务端注入，
# 绝不进入前端构建产物或浏览器可见的 URL。留空时发送空 Bearer 头（无鉴权服务通常忽略）。
# 原样发送：token 含 `$`（如 ComfyUI 自动生成的 "$2b$12$..." 形态）也安全——nginx 用
# geo 字面量持有该值，不会把 `$` 误当变量解析。直接粘贴原始 token，无需转义/编码。
COMFYUI_FIXED_TOKEN=

# === NyaaComfyUI T2I Agent（独立画图提示词生成）===
# 是否启用独立画图提示词 agent。false 时 comfyui-fixed 回退到用户对话 LLM 生成提示词。
# 非密钥，经 Vite define 注入前端。
COMFYUI_FIXED_T2I_AGENT_ENABLE=false
# Agent LLM API 基地址（仅 ext-host 服务端使用，绝不进前端 bundle）。
COMFYUI_FIXED_T2I_AGENT_API_BASEURL=https://api.deepseek.com
# Agent LLM API 密钥（机密！仅 ext-host 服务端 process.env，绝不进前端）。
COMFYUI_FIXED_T2I_AGENT_API_APIKEY=sk-your-key-here
# Agent 使用的模型（仅 ext-host 服务端强制，前端不可覆盖）。
# 注意：deepseek-flash / deepseek-v4-pro 都是推理模型，隐藏思考 token 与正文共享 max_tokens 预算。
COMFYUI_FIXED_T2I_AGENT_API_MODEL=deepseek-flash
# 生成提示词的输出上限（tokens）。设太小（≤128）会让思考吃光预算、正文为空。
# 代码内置下限 512、默认 1600；低于下限会被夹到 512。
COMFYUI_FIXED_T2I_AGENT_API_MAX_TOKENS=1600
# 是否保留模型思考（on/off，默认 off）。off 时请求带 reasoning_effort:"none"，
# 实测 completion tokens −49%、延迟 −34%，输出质量不降。on = 保留思考（更慢更贵）。
COMFYUI_FIXED_T2I_AGENT_API_REASONING=off

# === quote-tts 插件语音合成（受控 TTS 代理）===
# 插件浏览器侧只调同源 /api/ext-host/plugins/quote-tts/speech，由 nginx 转到
# ext-host 容器。上游地址 / 模型 / 鉴权**只**从下列变量读取——请求体里出现
# provider_endpoint / baseUrl / model / api_key 一律被忽略（旧 /openai/custom/
# generate-voice 从 body 取上游地址，属 SSRF 形态，已被删除且不得重建）。
# 未配置 PLUGIN_QUOTE_TTS_UPSTREAM_URL 时该路由返回 503（/status 里
# plugins.quoteTts.configured 为 false）。
# Edge-TTS 兼容端点基地址（非密钥；ext-host 会自行追加 /v1/audio/speech）。
PLUGIN_QUOTE_TTS_UPSTREAM_URL=http://your-tts-host:0000
# 上游模型 id（非密钥，仅 ext-host 服务端强制，前端不可覆盖）。
PLUGIN_QUOTE_TTS_MODEL=tts-1-hd
# 上游鉴权（机密！仅 ext-host 服务端 process.env，绝不进前端）。
# 默认 none：上游 schema 要求非空 Authorization，留空时仍发送 "Bearer none"。
PLUGIN_QUOTE_TTS_API_KEY=none
# 上游请求超时（ms）。默认 60000；代码内置区间 [1000, 600000]。
PLUGIN_QUOTE_TTS_TIMEOUT_MS=60000

# === NyaaAcount 统一账号平台（凭证转发）===
# 共享后端登录/注册/改密经 NyaaAcount /api/project/* 校验（P7-3），本地不再存密码。
# 三个值来自 NyaaAcount 侧 .env（NYAAACOUNT_API_TOKEN_NYAACHAT / _ENCRYPTION_KEY_NYAACHAT）。
NYAAACOUNT_PUBLIC_URL=http://your-nyaacount-host:5110
NYAAACOUNT_API_TOKEN=
NYAAACOUNT_ENCRYPTION_KEY=

# === Shared-secret for nyaachat-knowledge ↔ nyaachat-shared internal API (P6) ===
# Shared-secret used by the shared-server to call knowledge-server's internal
# binding-management endpoints. Both containers must see the same value.
# Generate via:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
INTERNAL_API_TOKEN=

# Knowledge server URL reachable from the shared-server container (P6).
# Default: http://nyaachat-knowledge:5108 (Docker service name).
KNOWLEDGE_SERVER_URL=http://nyaachat-knowledge:5108

# === Knowledge base backend 大文件存储基路径（docker-compose.knowledge.yml）===
# 知识库后端的 sqlite db 与向量库 bind mount 的宿主机基路径，其下创建 db/。
# 按项目 Docker 大文件约定指向大容量盘（如 Windows 的 E:/DockerRes/nyaachat-knowledge）。
# 默认 "." = 当前目录，使开源 compose 文件不含任何机器相关路径。
KNOWLEDGE_RES_DIR=.

# === Shared-character backend 大文件存储基路径（docker-compose.shared.yml）===
# 共享角色后端的 sqlite db 与封面图 bind mount 的宿主机基路径，其下创建 db/ 与 covers/。
# 按项目 Docker 大文件约定指向大容量盘（如 Windows 的 E:/DockerRes/nyaachat-shared）。
# 默认 "." = 当前目录，使开源 compose 文件不含任何机器相关路径。
SHARED_RES_DIR=.

# === NyaaDockerHUB private registry (macmini migration, optional) ===
# Required for macmini deployment; not needed for local dev.
# Windows (build+push): localhost:5000 — avoids Docker Desktop NAT hairpin
# macmini (deploy+pull): 192.168.31.142:5000 — Windows host LAN IP
PRIVATE_DOCKER_REGISTRY_HOST=

# Private registry HTTP API base URL (for tag cleanup). Defaults to http://<HOST> if unset.
# PRIVATE_DOCKER_REGISTRY_URL=
