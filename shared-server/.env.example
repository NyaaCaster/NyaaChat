# Host bind-mount base path for the shared-character backend's persistent data.
# Set SHARED_RES_DIR in the main .env (project root) — docker-compose.shared.yml
# reads it from there and creates db/ and covers/ subdirectories underneath.
#
# Default: "." (current directory). Point this to a large-capacity disk for
# production, e.g.:
#   SHARED_RES_DIR=E:/DockerRes/nyaachat-shared          (Windows)
#   SHARED_RES_DIR=/srv/DockerRes/nyaachat-shared        (Linux)
#
# See also: the main .env.example in the project root.
SHARED_RES_DIR=.