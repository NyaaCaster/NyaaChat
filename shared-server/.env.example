# Host bind-mount paths for the shared-character backend's persistent data.
# Copy to `.env` (in this repo root) to override the Windows defaults baked
# into docker-compose.shared.yml. On Linux/macOS set absolute paths, e.g.:
#   SHARED_DB_DIR=/srv/DockerRes/nyaachat-shared/db
#   SHARED_COVERS_DIR=/srv/DockerRes/nyaachat-shared/covers
SHARED_DB_DIR=E:/DockerRes/nyaachat-shared/db
SHARED_COVERS_DIR=E:/DockerRes/nyaachat-shared/covers
