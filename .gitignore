node_modules/
build/
dist/
coverage/
.DS_Store
*.log
src/temp/
.env*
!.env.example
# Claude Code per-machine settings (permissions, env, etc.) — not for sharing
.claude/settings.local.json
# Playwright MCP browser artifacts
.playwright-mcp/
# Local reference material — not for sharing
.ref/
# Shared-character backend local data (sqlite db / covers when run outside
# Docker). In production these live on host bind mounts, not in the repo.
shared-server/data/
# Operator-managed third-party SillyTavern extensions. Extension directories
# and generated registry are maintained locally by git/rebuild.
public/extensions/*/
public/extensions/registry.json
# Generated outbound allowlist for the ext-host sidecar, aggregated from
# installed extensions' declared network_endpoints at rebuild time.
ext-host/network-allowlist.generated.json
# Patent-protected subservices — maintained in separate private repos
# (NyaaChat-knowledge-server / NyaaChat-shared-server). Kept in-tree locally
# for development & Docker build only; NOT part of this public repo.
/nyaachat-knowledge/
/shared-server/
# Private engineering artifacts of features that must NOT be public (e.g. the
# AnswererFlagalac review-bypass module: its payload/config docs, probe scripts
# and design/SSOT documents). Maintained in the separate private repo
# NyaaChat-Private (github.com/NyaaCaster/NyaacChat-Private); kept in-tree
# locally for development, never committed here.
/.private/
